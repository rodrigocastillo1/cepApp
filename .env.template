# Copy this file to .env and enter your local settings there.
# Keep real credentials out of this tracked template.

# Choose one provider: openai or gemini.
AI_PROVIDER=openai
# AI_PROVIDER=gemini

# Add the API key for the selected provider in your local .env file.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Models used by each provider.
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-3.5-flash-lite

# Replace this placeholder in your local .env file.
SECRET_KEY=